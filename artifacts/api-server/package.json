{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:vercel": "node ./build-vercel.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "file:../../lib/api-zod",
    "@workspace/db": "file:../../lib/db",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "midtrans-client": "^1.4.3",
    "multer": "^2.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.12"
  }
}
