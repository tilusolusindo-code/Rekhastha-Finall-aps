# ---- API (set in Vercel -> Project Settings -> Environment Variables) ----
# Supabase -> Connect -> "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose to the browser
SUPABASE_JWT_SECRET=                  # Project Settings -> API -> JWT Secret (legacy HS256)
SUPABASE_STORAGE_BUCKET=rekhastha-private

ADMIN_ID=tilu_admin
ADMIN_TOKEN=
PUBLIC_APP_HOSTS=                     # custom domain(s), comma separated (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_SIGNATURE_SECRET_KEY=         # "Signature Secret Key" (Settings > Access Keys), untuk verifikasi notifikasi
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
REQUIRE_ACADEMY=

# ---- Frontend (build-time, public) ----
VITE_SUPABASE_URL=https://PROJECTREF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Security hardening ---
# Password-reset emails (Resend). Without these, reset links are NOT delivered.
# RESEND_API_KEY=re_xxx
# MAIL_FROM="Rekhastha <no-reply@your-domain.id>"
# Public https origin used inside reset links
# APP_BASE_URL=https://your-domain.id
# Extra origins allowed to make state-changing calls (comma separated). Normally empty.
# ALLOWED_ORIGINS=
# Local development ONLY: return the reset token in the API response (ignored in production).
# DEV_RETURN_RESET_TOKEN=true

# === Google Cloud Integration ===
# OAuth 2.0 (Login dengan Google)
# Buat di: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI akan dibuat otomatis dari request host

# Gmail API (Email transaksional)
# Isi dengan JSON key Service Account yang sudah didownload (minify ke 1 baris)
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_SENDER_ADDRESS=

# App base URL (untuk link di email)
APP_BASE_URL=https://rekhastha-finall-aps.vercel.app

# Cloud Storage (Backup database)
GCS_BACKUP_BUCKET=rekhastha-db-backup-prod

# Cloud Run (Tugas berat)
CLOUD_RUN_PDF_URL=
CLOUD_RUN_RECONCILE_URL=

# Opsional: pemindaian hash berkas unggahan ke VirusTotal (kunci gratis di virustotal.com)
VIRUSTOTAL_API_KEY=
